+// ggml_allreduce
+
+struct ggml_tensor * ggml_allreduce(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a) {
+    GGML_ASSERT(ggml_is_contiguous(a));
+
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, a);
+    ggml_format_name(result, "%s (allreduce)", a->name);
+
+    result->op     = GGML_OP_ALLREDUCE;
+    result->src[0] = a;
+
+    return result;
+}
