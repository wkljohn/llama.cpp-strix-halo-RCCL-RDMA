+// ---------------------------------------------------------------------------
+// Cross-process "world" communicator: tensor parallelism across NODES.
+//
+// Unlike the per-meta-backend comm context above (ncclCommInitAll over local
+// GPUs in one process), this is a process-global communicator built with
+// ncclCommInitRank so the ranks can live in different processes on different
+// machines (e.g. llama-server as rank 0 and ggml-rpc-server as rank 1).
+// The ncclUniqueId is exchanged over a plain TCP socket; NCCL/RCCL then runs
+// the collective over its own transports (sockets or IB verbs).
+//
+// Config (env, all three required):
+//   GGML_NCCL_RANK    rank of this process (0 = master / rendezvous listener)
+//   GGML_NCCL_WORLD   world size (2 for a two-node split)
+//   GGML_NCCL_MASTER  <ip:port> where rank 0 listens for the id exchange
+//
+// Consumed by GGML_OP_ALLREDUCE graph nodes: each rank executes its own copy
+// of the graph and the ranks rendezvous *inside* the collective — no per-op
+// RPC round trips. Single-GPU-per-process is assumed (device 0).
+#ifdef GGML_USE_NCCL
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+static ncclComm_t g_world_comm = nullptr;
+static int        g_world_rank = -1;
+static int        g_world_size = 0;
+static std::mutex g_world_mutex;
+
+static bool ggml_cuda_world_configured(void) {
+    return getenv("GGML_NCCL_RANK") != nullptr &&
+           getenv("GGML_NCCL_WORLD") != nullptr &&
+           getenv("GGML_NCCL_MASTER") != nullptr;
+}
+
+static bool ggml_cuda_world_init_once(void) {
+    std::lock_guard<std::mutex> lock(g_world_mutex);
+    if (g_world_comm != nullptr) {
+        return true;
+    }
+    if (!ggml_cuda_world_configured()) {
+        return false;
+    }
+
+    const int rank  = atoi(getenv("GGML_NCCL_RANK"));
+    const int world = atoi(getenv("GGML_NCCL_WORLD"));
+
+    char master[256];
+    snprintf(master, sizeof(master), "%s", getenv("GGML_NCCL_MASTER"));
+    char * colon = strrchr(master, ':');
+    if (colon == nullptr || world < 2 || rank < 0 || rank >= world) {
+        GGML_LOG_ERROR("%s: bad world config (rank=%d world=%d master=%s)\n", __func__, rank, world, master);
+        return false;
+    }
+    *colon = '\0';
+    const char * ip   = master;
+    const int    port = atoi(colon + 1);
+
+    ncclUniqueId id;
+    if (rank == 0) {
+        NCCL_CHECK(ncclGetUniqueId(&id));
+        int srv = socket(AF_INET, SOCK_STREAM, 0);
+        if (srv < 0) { GGML_LOG_ERROR("%s: socket() failed\n", __func__); return false; }
+        int yes = 1;
+        setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
+        sockaddr_in addr = {};
+        addr.sin_family      = AF_INET;
+        addr.sin_port        = htons((uint16_t) port);
+        addr.sin_addr.s_addr = INADDR_ANY;
+        if (bind(srv, (sockaddr *) &addr, sizeof(addr)) != 0 || listen(srv, world) != 0) {
+            GGML_LOG_ERROR("%s: bind/listen on port %d failed\n", __func__, port);
+            close(srv);
+            return false;
+        }
+        GGML_LOG_INFO("%s: rank 0 waiting for %d peer(s) on port %d\n", __func__, world - 1, port);
+        for (int r = 1; r < world; ++r) {
+            int c = accept(srv, nullptr, nullptr);
+            if (c < 0) { GGML_LOG_ERROR("%s: accept failed\n", __func__); close(srv); return false; }
+            ssize_t sent = 0;
+            while (sent < (ssize_t) sizeof(id)) {
+                ssize_t n = write(c, (const char *) &id + sent, sizeof(id) - sent);
+                if (n <= 0) { GGML_LOG_ERROR("%s: id send failed\n", __func__); close(c); close(srv); return false; }
+                sent += n;
+            }
+            close(c);
+        }
+        close(srv);
+    } else {
+        int c = -1;
+        for (int attempt = 0; attempt < 600; ++attempt) {   // retry up to ~60s: rank 0 may not be up yet
+            c = socket(AF_INET, SOCK_STREAM, 0);
+            sockaddr_in addr = {};
+            addr.sin_family = AF_INET;
+            addr.sin_port   = htons((uint16_t) port);
+            inet_pton(AF_INET, ip, &addr.sin_addr);
+            if (connect(c, (sockaddr *) &addr, sizeof(addr)) == 0) {
+                break;
+            }
+            close(c);
+            c = -1;
+            usleep(100 * 1000);
+        }
+        if (c < 0) {
+            GGML_LOG_ERROR("%s: could not reach rank 0 at %s:%d\n", __func__, ip, port);
+            return false;
+        }
+        ssize_t got = 0;
+        while (got < (ssize_t) sizeof(id)) {
+            ssize_t n = read(c, (char *) &id + got, sizeof(id) - got);
+            if (n <= 0) { GGML_LOG_ERROR("%s: id recv failed\n", __func__); close(c); return false; }
+            got += n;
+        }
+        close(c);
+    }
+
+    ggml_cuda_set_device(0);
+    ncclResult_t rc = ncclCommInitRank(&g_world_comm, world, id, rank);
+    if (rc != ncclSuccess) {
+        GGML_LOG_ERROR("%s: ncclCommInitRank failed: %s\n", __func__, ncclGetErrorString(rc));
+        g_world_comm = nullptr;
+        return false;
+    }
+    g_world_rank = rank;
+    g_world_size = world;
+    GGML_LOG_INFO("%s: world communicator up: rank %d/%d (master %s:%d)\n", __func__, rank, world, ip, port);
+    return true;
+}
+#endif // GGML_USE_NCCL
+
+static bool ggml_cuda_world_available(void) {
+#ifdef GGML_USE_NCCL
+    return g_world_comm != nullptr || ggml_cuda_world_configured();
+#else
+    return false;
+#endif // GGML_USE_NCCL
+}
+
+bool ggml_backend_cuda_world_init(void) {
+#ifdef GGML_USE_NCCL
+    return ggml_cuda_world_init_once();
+#else
+    return false;
+#endif // GGML_USE_NCCL
+}
